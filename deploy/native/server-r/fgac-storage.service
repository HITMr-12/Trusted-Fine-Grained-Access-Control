[Unit]
Description=FGAC governed Parquet storage service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fgac
Group=fgac
WorkingDirectory=/opt/fgac
EnvironmentFile=/etc/fgac/storage.env
ExecStart=/opt/fgac/venv/bin/uvicorn storage.app:app --host 0.0.0.0 --port 8003
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/fgac/data

[Install]
WantedBy=multi-user.target
