[Unit]
Description=FGAC Remote execution service
After=network-online.target fgac-polaris.service fgac-storage.service
Wants=network-online.target
Requires=fgac-polaris.service fgac-storage.service

[Service]
Type=simple
User=fgac
Group=fgac
WorkingDirectory=/opt/fgac
EnvironmentFile=/etc/fgac/remote.env
ExecStart=/opt/fgac/venv/bin/uvicorn remote.app:app --host 0.0.0.0 --port 8002
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
